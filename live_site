    <button id="mob-pdf-btn" class="btn-secondary" aria-label="Download PDF price list">
      <i class="fas fa-file-pdf" aria-hidden="true"></i> Price List PDF
    </button>
  </div>

  <!-- jsPDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" defer></script>

  <script>
  /* ══════════════════════════════════════════════════
     CONFIG — nav items
  ══════════════════════════════════════════════════ */
  var NAV = [
    { label: 'Prices',    href: '#prices',   icon: 'fa-tag' },
    { label: 'Services',  href: '#services', icon: 'fa-paint-roller' },
    { label: 'Our Works', href: '#work',     icon: 'fa-images' },
    { label: 'Contact',   href: '#contact',  icon: 'fa-envelope' }
  ];

  /* ══════════════════════════════════════════════════
     BUILD DESKTOP NAV
  ══════════════════════════════════════════════════ */
  (function () {
    var ul = document.getElementById('desktop-nav');
    NAV.forEach(function (item) {
      var li = document.createElement('li');
      var a  = document.createElement('a');
      a.href = item.href;
      a.textContent = item.label;
      li.appendChild(a);
      ul.appendChild(li);
    });
  })();

  /* ══════════════════════════════════════════════════
     BUILD MOBILE DRAWER
  ══════════════════════════════════════════════════ */
  (function () {
    var drawer = document.getElementById('mob-drawer');
    NAV.forEach(function (item) {
      var a = document.createElement('a');
      a.href = item.href;
      a.innerHTML = '<i class="fas ' + item.icon + '" aria-hidden="true"></i> ' + item.label;
      a.addEventListener('click', closeDrawer);
      drawer.appendChild(a);
    });
    var ph = document.createElement('a');
    ph.href = 'tel:0899510552';
    ph.innerHTML = '<i class="fas fa-phone-alt" aria-hidden="true"></i> 089 951 0552';
    ph.addEventListener('click', closeDrawer);
    drawer.appendChild(ph);
  })();

  /* ══════════════════════════════════════════════════
     HAMBURGER TOGGLE
  ══════════════════════════════════════════════════ */
  var hamburger = document.getElementById('hamburger-btn');
  var drawer    = document.getElementById('mob-drawer');
  var drawerOpen = false;

  function openDrawer () {
    drawerOpen = true;
    drawer.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    hamburger.innerHTML = '<i class="fas fa-times" aria-hidden="true"></i>';
  }
  function closeDrawer () {
    drawerOpen = false;
    drawer.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    hamburger.innerHTML = '<i class="fas fa-bars" aria-hidden="true"></i>';
  }
  hamburger.addEventListener('click', function () {
    drawerOpen ? closeDrawer() : openDrawer();
  });

  /* ══════════════════════════════════════════════════
     THEME TOGGLE
  ══════════════════════════════════════════════════ */
  var themeBtn  = document.getElementById('theme-btn');
  var themeIcon = document.getElementById('theme-icon');
  var heroImg   = document.getElementById('hero-img');

  function applyTheme (light) {
    document.body.classList.toggle('light', light);
    themeIcon.className = light ? 'fas fa-moon' : 'fas fa-sun';
    if (heroImg) heroImg.src = light ? 'mariojpgw_wide.png' : 'mariojpgb_wide.png';
    try { localStorage.setItem('dp_theme', light ? 'light' : 'dark'); } catch(e){}
  }

  /* Load saved preference */
  var savedTheme;
  try { savedTheme = localStorage.getItem('dp_theme'); } catch(e){}
  applyTheme(savedTheme === 'light');

  themeBtn.addEventListener('click', function () {
    applyTheme(!document.body.classList.contains('light'));
  });

  /* ══════════════════════════════════════════════════
     SCROLL EFFECTS — nav shrink, active links, scroll-top
  ══════════════════════════════════════════════════ */
  var nav       = document.getElementById('nav');
  var scrollTop = document.getElementById('scroll-top');
  var sections  = ['prices', 'services', 'work', 'contact'];

  window.addEventListener('scroll', function () {
    var sy = window.scrollY;

    /* Nav border */
    nav.classList.toggle('scrolled', sy > 40);

    /* Scroll-to-top button */
    scrollTop.classList.toggle('vis', sy > 320);

    /* Active section highlight */
    var cur = '';
    sections.forEach(function (id) {
      var el = document.getElementById(id);
      if (el && sy >= el.offsetTop - 100) cur = id;
    });

    /* Update desktop nav */
    document.querySelectorAll('#desktop-nav a').forEach(function (a) {
      a.classList.toggle('active', a.getAttribute('href') === '#' + cur);
    });
    /* Update subnav */
    document.querySelectorAll('#hero-subnav a').forEach(function (a) {
      var href = a.getAttribute('href');
      if (href && href.startsWith('#')) {
        a.classList.toggle('active', href === '#' + cur);
      }
    });
  }, { passive: true });

  /* ══════════════════════════════════════════════════
     INTERSECTION OBSERVER — reveal animations
  ══════════════════════════════════════════════════ */
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry, i) {
      if (entry.isIntersecting) {
        setTimeout(function () {
          entry.target.classList.add('vis');
        }, i * 60);
      }
    });
  }, { threshold: 0.07 });

  document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

  /* ══════════════════════════════════════════════════
     EMAIL ANTI-SPAM
  ══════════════════════════════════════════════════ */
  (function () {
    var addr = 'mario' + '@' + 'dublinpainter' + '.ie';
    var el   = document.getElementById('email-link');
    if (el) {
      el.href      = 'mailto:' + addr;
      el.textContent = addr;
    }
  })();

  /* ══════════════════════════════════════════════════
     PDF GENERATION (jsPDF)
     Called on download button click — waits for jsPDF
     to be available before running.
  ══════════════════════════════════════════════════ */
  function generatePDF () {
    if (!window.jspdf || !window.jspdf.jsPDF) {
      alert('PDF library is still loading, please try again in a moment.');
      return;
    }

    var jsPDF = window.jspdf.jsPDF;
    var doc   = new jsPDF({ unit: 'mm', format: 'a4' });

    var PW = 210, PH = 297, ML = 16, MR = 16;
    var CW = PW - ML - MR;
    var G  = [34, 197, 94];    /* green */
    var DK = [9, 9, 11];       /* near-black */
    var LG = [245, 245, 245];  /* light grey */
    var MG = [120, 120, 130];  /* mid grey */
    var WH = [255, 255, 255];

    function rgb(c) { doc.setFillColor(c[0], c[1], c[2]); }
    function txt(c) { doc.setTextColor(c[0], c[1], c[2]); }
    function drw(c) { doc.setDrawColor(c[0], c[1], c[2]); }

    /* Draw a simple price table; returns updated y */
    function table (headers, rows, colW, y) {
      var hH = 9, rH = 8, x = ML;

      /* header */
      rgb(G); doc.rect(x, y, CW, hH, 'F');
      doc.setFont('helvetica', 'bold');
      doc.setFontSize(8);
      txt(WH);
      var cx = x;
      headers.forEach(function (h, i) {
        doc.text(h, cx + colW[i] / 2, y + hH / 2 + 1.5, { align: 'center', maxWidth: colW[i] - 3 });
        cx += colW[i];
      });
      y += hH;

      /* rows */
      rows.forEach(function (row, r) {
        if (y + rH > PH - 24) { doc.addPage(); y = 22; }
        rgb(r % 2 === 0 ? WH : LG);
        doc.rect(x, y, CW, rH, 'F');
        cx = x;
        row.forEach(function (cell, i) {
          var last = (i === row.length - 1);
          txt(last ? G : DK);
          doc.setFont('helvetica', last ? 'bold' : 'normal');
          doc.setFontSize(8);
          var align = i === 0 ? 'left' : 'center';
          var tx    = i === 0 ? cx + 3  : cx + colW[i] / 2;
          doc.text(String(cell), tx, y + rH / 2 + 1.5, { align: align, maxWidth: colW[i] - 4 });
          cx += colW[i];
        });
        drw([220, 220, 220]);
        doc.setLineWidth(0.15);
        doc.line(x, y + rH, x + CW, y + rH);
        y += rH;
      });

      drw(G);
      doc.setLineWidth(0.5);
      doc.rect(x, y - rows.length * rH - hH, CW, rows.length * rH + hH, 'S');
      return y;
    }

    /* ── Header ── */
    rgb(DK); doc.rect(0, 0, PW, 38, 'F');
    rgb(G);  doc.rect(0, 38, PW, 1.5, 'F');
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(22);
    txt(WH);
    doc.text('DublinPainter.ie', PW / 2, 17, { align: 'center' });
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    txt(G);
    doc.text('Professional Painting & Decorating  |  Price List 2026', PW / 2, 28, { align: 'center' });

    var y = 46;

    /* ── Exterior ── */
    doc.setFont('helvetica', 'bold'); doc.setFontSize(12); txt(G);
    doc.text('Exterior Painting Costs', ML, y); y += 6;
    y = table(
      ['Property Type', 'Size Range', 'Estimated Price'],
      [
        ['Terraced House',  'Small (80–120 m²)',   '€1,200 – €2,000'],
        ['Terraced House',  'Medium (120–150 m²)', '€1,800 – €2,500'],
        ['Semi-Detached',   'Medium (120–180 m²)', '€1,800 – €3,000'],
        ['Semi-Detached',   'Large (180–220 m²)',  '€2,500 – €3,800'],
        ['Detached House',  'Medium (150–220 m²)', '€2,500 – €4,000'],
        ['Detached House',  'Large (220–350 m²)',  '€3,500 – €5,500'],
        ['Detached House',  'Very Large (350+ m²)','€5,000 – €9,000+']
      ],
      [CW * 0.40, CW * 0.35, CW * 0.25], y
    );
    y += 3;
    doc.setFont('helvetica', 'italic'); doc.setFontSize(7.5); txt(MG);
    doc.text('Includes: Minor surface repairs, priming where required, two coats high-quality exterior masonry paint.', ML, y);
    y += 10;

    /* ── Interior ── */
    if (y > PH - 90) { doc.addPage(); y = 22; }
    doc.setFont('helvetica', 'bold'); doc.setFontSize(12); txt(G);
    doc.text('Interior Painting Costs', ML, y); y += 6;
    y = table(
      ['Room Type', 'Average Size', 'Standard Price'],
      [
        ['Small Bedroom',            '8–12 m²',  '€250 – €350'],
        ['Master Bedroom',           '15–22 m²', '€350 – €450'],
        ['Living Room',              '18–25 m²', '€350 – €500'],
        ['Kitchen',                  '10–20 m²', '€400 – €550'],
        ['Hallway, Stairs & Landing','Varies',   '€500 – €700'],
        ['Bathroom',                 '5–10 m²',  '€200 – €300'],
        ['Dining Room',              '12–20 m²', '€300 – €450'],
        ['Home Office',              '8–15 m²',  '€250 – €400']
      ],
      [CW * 0.44, CW * 0.26, CW * 0.30], y
    );
    y += 10;

    /* ── Additional ── */
    if (y > PH - 62) { doc.addPage(); y = 22; }
    doc.setFont('helvetica', 'bold'); doc.setFontSize(12); txt(G);
    doc.text('Additional Services', ML, y); y += 6;
    y = table(
      ['Service', 'Estimated Cost'],
      [
        ['Ceiling Painting',                          '€80 – €150 per room'],
        ['Woodwork (skirting, architraves, frames)',   '€120 – €250 per room'],
        ['Feature Wall',                               '€100 – €200 additional'],
        ['Metal Cladding, Barriers & Fences',          'Ask for quote'],
        ['Wallpaper Hanging & Removal',                'Ask for quote']
      ],
      [CW * 0.62, CW * 0.38], y
    );
    y += 6;

    /* ── Notes ── */
    doc.setFont('helvetica', 'normal'); doc.setFontSize(7.5); txt(MG);
    var noteLines = doc.splitTextToSize(
      'All prices include labour and tools. Works include dust sheets, filling cracks, 2 coats ceiling emulsion, ' +
      '2 coats vinyl matt on walls, 1 coat gloss/satin on doors & skirtings. Free colour consultation. No hidden costs.',
      CW
    );
    doc.text(noteLines, ML, y); y += noteLines.length * 4 + 7;

    /* ── Green rule ── */
    rgb(G); doc.rect(ML, y, CW, 0.8, 'F'); y += 7;

    /* ── Contact block ── */
    if (y > PH - 28) { doc.addPage(); y = 22; }
    var cW4 = CW / 4;
    rgb(LG); doc.rect(ML, y, CW, 20, 'F');
    drw(G); doc.setLineWidth(0.5); doc.rect(ML, y, CW, 20, 'S');
    [
      ['Phone',  '089 951 0552'],
      ['Email',  'mario@dublinpainter.ie'],
      ['Hours',  'Mon–Sat: 8am–7pm'],
      ['Web',    'www.dublinpainter.ie']
    ].forEach(function (p, i) {
      var cx = ML + i * cW4 + cW4 / 2;
      doc.setFont('helvetica', 'bold'); doc.setFontSize(7); txt(MG);
      doc.text(p[0].toUpperCase(), cx, y + 7, { align: 'center' });
      doc.setFont('helvetica', 'bold'); doc.setFontSize(8); txt(DK);
      doc.text(p[1], cx, y + 14, { align: 'center', maxWidth: cW4 - 4 });
    });

    doc.save('DublinPainter-PriceList-2026.pdf');
  }

  /* Wire up all PDF buttons */
  function wirePDF (id) {
    var btn = document.getElementById(id);
    if (btn) btn.addEventListener('click', generatePDF);
  }
  wirePDF('download-pdf-btn');
  wirePDF('mob-pdf-btn');

  /* ══════════════════════════════════════════════════
     PHONE CLICK TRACKING (GA4 — if present)
  ══════════════════════════════════════════════════ */
  document.addEventListener('click', function (e) {
    var el = e.target.closest('a[href^="tel:"]');
    if (el && typeof gtag === 'function') {
      gtag('event', 'phone_click', {
        event_category: 'contact',
        event_label: el.href.replace('tel:', '')
      });
    }
  });
  </script>

