  <!-- Mobile sticky bar -->
  <div class="sticky-mob-bar" aria-label="Quick actions" role="toolbar">
    <a href="tel:0899510552" class="btn-primary" aria-label="Call us now">
      <i class="fas fa-phone-alt" aria-hidden="true"></i> Call Now
