<button id="st" onclick="window.scrollTo({top:0,behavior:'smooth'})"><i class="fas fa-chevron-up"></i></button>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
var NAV_ITEMS = [
  { label:'Prices',    href:'#prices'   },
  { label:'Services',  href:'#services' },
  { label:'Our Works', href:'#work'     }
];
(function(){
  var ul=document.getElementById('desktopNavLinks');
  NAV_ITEMS.forEach(function(item){ var li=document.createElement('li'),a=document.createElement('a'); a.href=item.href; a.textContent=item.label; li.appendChild(a); ul.appendChild(li); });
})();
(function(){
  var ul=document.getElementById('heroNavLinks');
  NAV_ITEMS.forEach(function(item,i){
    if(i>0){ var sep=document.createElement('li'),d=document.createElement('div'); d.className='hn-sep'; sep.appendChild(d); ul.appendChild(sep); }
    var li=document.createElement('li'),a=document.createElement('a'); a.href=item.href; a.textContent=item.label; li.appendChild(a); ul.appendChild(li);
  });
})();
(function(){
  var drawer=document.getElementById('sharedMobMenu');
  NAV_ITEMS.forEach(function(item){ var a=document.createElement('a'); a.href=item.href; a.textContent=item.label; drawer.appendChild(a); });
  var ph=document.createElement('a'); ph.href='tel:0899510552'; ph.innerHTML='<i class="fas fa-phone-alt me-2"></i>089 951 0552'; drawer.appendChild(ph);
})();

function toggleMenu(){ document.getElementById('sharedMobMenu').classList.toggle('open'); }
function closeMenu() { document.getElementById('sharedMobMenu').classList.remove('open'); }
document.getElementById('hbtnNav').addEventListener('click',toggleMenu);
document.getElementById('hbtnHero').addEventListener('click',toggleMenu);
document.querySelectorAll('#sharedMobMenu a').forEach(function(a){ a.addEventListener('click',closeMenu); });

var nav=document.getElementById('mainNav'), heroNav=document.getElementById('hero-nav'),
    mobMenu=document.getElementById('sharedMobMenu'), stBtn=document.getElementById('st');
var wasScrolled=false, wasStVisible=false;

function attachDrawerToHeroNav(){
  if(heroNav.nextSibling!==mobMenu) heroNav.parentNode.insertBefore(mobMenu,heroNav.nextSibling);
  mobMenu.style.position='sticky'; mobMenu.style.top='54px';
}
function attachDrawerToCompactNav(){
  if(!nav.contains(mobMenu)) nav.appendChild(mobMenu);
  mobMenu.style.top=''; mobMenu.style.position='';
}
attachDrawerToHeroNav();

window.addEventListener('scroll',function(){
  var scrolled=heroNav.getBoundingClientRect().bottom<=0;
  if(scrolled!==wasScrolled){ nav.classList.toggle('scrolled',scrolled); scrolled?attachDrawerToCompactNav():attachDrawerToHeroNav(); wasScrolled=scrolled; }
  var stV=scrollY>300; if(stV!==wasStVisible){ stBtn.classList.toggle('visible',stV); wasStVisible=stV; }
  var cur='';
  document.querySelectorAll('section[id],#hero').forEach(function(s){ if(scrollY>=s.offsetTop-80) cur=s.id; });
  document.querySelectorAll('.nav-links a,.hn-links a,#sharedMobMenu a').forEach(function(l){ l.classList.remove('active'); if(l.getAttribute('href')==='#'+cur) l.classList.add('active'); });
});

var io=new IntersectionObserver(function(e){ e.forEach(function(x,i){ if(x.isIntersecting) setTimeout(function(){ x.target.classList.add('visible'); },i*55); }); },{threshold:.08});
document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });

function storageSave(k,v){ try{localStorage.setItem(k,v);}catch(e){} }
function storageLoad(k)  { try{return localStorage.getItem(k);}catch(e){return null;} }

var tNav=document.getElementById('themeToggleNav'), tHero=document.getElementById('themeToggleHero');
var iNav=document.getElementById('themeIconNav'),   iHero=document.getElementById('themeIconHero');
var heroImg=document.getElementById('hero-img');

if(storageLoad('theme')==='light'){
  document.body.classList.add('light-mode');
  iNav.classList.replace('fa-sun','fa-moon'); iHero.classList.replace('fa-sun','fa-moon');
  if(heroImg) heroImg.src='mariojpgw_wide.png';
} else { if(heroImg) heroImg.src='mariojpgb_wide.png'; }

function toggleTheme(){
  document.body.classList.toggle('light-mode');
  var L=document.body.classList.contains('light-mode');
  iNav.classList.toggle('fa-sun',!L);  iNav.classList.toggle('fa-moon', L);
  iHero.classList.toggle('fa-sun',!L); iHero.classList.toggle('fa-moon',L);
  var img=document.getElementById('hero-img'); if(img) img.src=L?'mariojpgw_wide.png':'mariojpgb_wide.png';
  storageSave('theme',L?'light':'dark');
}
tNav.addEventListener('click',toggleTheme); tHero.addEventListener('click',toggleTheme);

document.addEventListener('click',function(e){
  var el=e.target.closest('a[href^="tel:"]');
  if(el&&typeof gtag==='function') gtag('event','phone_click',{event_category:'contact',event_label:el.href.replace('tel:','')});
});

(function(){
  function rot13(s){ return s.replace(/[a-zA-Z]/g,function(c){ return String.fromCharCode((c<='Z'?90:122)>=(c=c.charCodeAt(0)+13)?c:c-26); }); }
  var addr='mario'+'@'+['dublinpainter','.ie'].join('');
  var el=document.getElementById('email-link');
  if(el){ el.href='mailto:'+addr; el.textContent=addr; el.addEventListener('click',function(){ if(typeof gtag==='function') gtag('event','email_click',{event_category:'contact',event_label:addr}); }); }
})();

/* ── Mobile card tables: stamp data-label on every <td> ──────────
   Each <td> gets a data-label matching its column header text.
   CSS then shows it as the left-hand label in the card layout.   */
(function(){
  document.querySelectorAll('.ptbl').forEach(function(tbl){
    var headers = Array.from(tbl.querySelectorAll('thead th')).map(function(th){
      return th.textContent.trim();
    });
    tbl.querySelectorAll('tbody tr').forEach(function(row){
      row.querySelectorAll('td').forEach(function(td, i){
        if(headers[i]) td.setAttribute('data-label', headers[i]);
      });
    });
  });
})();

/* ── PDF Generation ────────────────────────────────────────────────
   Produces a professional A4 price list using jsPDF.
   Dark header band, green accents, alternating rows, contact block.
─────────────────────────────────────────────────────────────────── */
document.getElementById('downloadPdfBtn').addEventListener('click', function(){
  var jsPDF = window.jspdf.jsPDF;
  var doc   = new jsPDF({ unit:'mm', format:'a4' });

  var PW=210, PH=297, ML=18, MR=18;
  var CW = PW-ML-MR;
  var GREEN=[62,207,78], BLACK=[10,10,10], MGREY=[136,136,136], LGREY=[245,245,245], WHITE=[255,255,255];

  function setFill(c){ doc.setFillColor(c[0],c[1],c[2]); }
  function setTxt(c) { doc.setTextColor(c[0],c[1],c[2]); }
  function setDrw(c) { doc.setDrawColor(c[0],c[1],c[2]); }

  /* Draw a table; returns Y after last row */
  function drawTable(headers, rows, colW, y){
    var headH=9, rowH=8, x=ML;
    /* header */
    setFill(GREEN); doc.rect(x,y,CW,headH,'F');
    doc.setFont('helvetica','bold'); doc.setFontSize(8); setTxt(WHITE);
    var cx=x;
    headers.forEach(function(h,i){ doc.text(h,cx+colW[i]/2,y+headH/2+1.5,{align:'center',maxWidth:colW[i]-3}); cx+=colW[i]; });
    y+=headH;
    /* rows */
    rows.forEach(function(row,r){
      if(y+rowH>PH-22){ doc.addPage(); y=20; }
      setFill(r%2===0?WHITE:LGREY); doc.rect(x,y,CW,rowH,'F');
      cx=x;
      row.forEach(function(cell,i){
        var last=(i===row.length-1);
        setTxt(last?GREEN:BLACK);
        doc.setFont('helvetica',last?'bold':'normal');
        doc.setFontSize(8);
        var align=i===0?'left':'center';
        var tx=i===0?cx+3:cx+colW[i]/2;
        doc.text(String(cell),tx,y+rowH/2+1.5,{align:align,maxWidth:colW[i]-4});
        cx+=colW[i];
      });
      setDrw([220,220,220]); doc.setLineWidth(0.2); doc.line(x,y+rowH,x+CW,y+rowH);
      y+=rowH;
    });
    setDrw(GREEN); doc.setLineWidth(0.5); doc.rect(x,y-rows.length*rowH-headH,CW,rows.length*rowH+headH,'S');
    return y;
  }

  /* Header band */
  setFill(BLACK); doc.rect(0,0,PW,36,'F');
  setFill(GREEN); doc.rect(0,36,PW,1.2,'F');
  doc.setFont('helvetica','bold'); doc.setFontSize(22); setTxt(WHITE);
  doc.text('DublinPainter.ie',PW/2,16,{align:'center'});
  doc.setFont('helvetica','normal'); doc.setFontSize(10); setTxt(GREEN);
  doc.text('Professional Painting & Decorating  |  Price List 2026',PW/2,27,{align:'center'});

  var y=44;

  /* Exterior */
  doc.setFont('helvetica','bold'); doc.setFontSize(12); setTxt(GREEN);
  doc.text('Exterior Painting Costs',ML,y); y+=6;
  y=drawTable(
    ['Property Type','Size Range','Estimated Price'],
    [['Terraced House','Small (80-120 m2)','€1,200 - €2,000'],
     ['Terraced House','Medium (120-150 m2)','€1,800 - €2,500'],
     ['Semi-Detached','Medium (120-180 m2)','€1,800 - €3,000'],
     ['Semi-Detached','Large (180-220 m2)','€2,500 - €3,800'],
     ['Detached House','Medium (150-220 m2)','€2,500 - €4,000'],
     ['Detached House','Large (220-350 m2)','€3,500 - €5,500'],
     ['Detached House','Very Large (350+ m2)','€5,000 - €9,000+']],
    [CW*0.40,CW*0.35,CW*0.25], y);
  y+=3;
  doc.setFont('helvetica','italic'); doc.setFontSize(7.5); setTxt(MGREY);
  doc.text('Includes: Minor surface repairs, priming where required, two coats high-quality exterior masonry paint.',ML,y);
  y+=9;

  /* Interior */
  if(y>PH-90){ doc.addPage(); y=20; }
  doc.setFont('helvetica','bold'); doc.setFontSize(12); setTxt(GREEN);
  doc.text('Interior Painting Costs',ML,y); y+=6;
  y=drawTable(
    ['Room Type','Average Size','Standard Price'],
    [['Small Bedroom','8-12 m2','€250 - €350'],
     ['Master Bedroom','15-22 m2','€350 - €450'],
     ['Living Room','18-25 m2','€350 - €500'],
     ['Kitchen','10-20 m2','€400 - €550'],
     ['Hallway, Stairs & Landing','Varies','€500 - €700'],
     ['Bathroom','5-10 m2','€200 - €300'],
     ['Dining Room','12-20 m2','€300 - €450'],
     ['Home Office','8-15 m2','€250 - €400']],
    [CW*0.44,CW*0.26,CW*0.30], y);
  y+=9;

  /* Additional */
  if(y>PH-60){ doc.addPage(); y=20; }
  doc.setFont('helvetica','bold'); doc.setFontSize(12); setTxt(GREEN);
  doc.text('Additional Services',ML,y); y+=6;
  y=drawTable(
    ['Service','Estimated Cost'],
    [['Ceiling Painting','€80 - €150 per room'],
     ['Woodwork (skirting, architraves, window frames)','€120 - €250 per room'],
     ['Feature Wall','€100 - €200 additional'],
     ['Metal Clading, Barriers and Fences','Ask'],
     ['Wallpaper','Ask']],
    [CW*0.62,CW*0.38], y);
  y+=5;

  /* Note */
  doc.setFont('helvetica','normal'); doc.setFontSize(7.5); setTxt(MGREY);
  var noteLines=doc.splitTextToSize(
    'All prices include labour and materials. Works include covering furniture/floors with dust sheets, '+
    'filling cracks, 2 coats ceiling emulsion, 2 coats vinyl matt on walls, 1 coat gloss/satin on doors & skirtings. '+
    'Free colour consultation included. No hidden costs.',CW);
  doc.text(noteLines,ML,y); y+=noteLines.length*4+6;

  /* Green rule */
  setFill(GREEN); doc.rect(ML,y,CW,0.8,'F'); y+=6;

  /* Contact block */
  if(y>PH-26){ doc.addPage(); y=20; }
  var cW4=CW/4;
  setFill(LGREY); doc.rect(ML,y,CW,18,'F');
  setDrw(GREEN); doc.setLineWidth(0.5); doc.rect(ML,y,CW,18,'S');
  [['Phone','089 951 0552'],['Email','mario@dublinpainter.ie'],['Hours','Mon-Sat: 8am-7pm'],['Web','www.dublinpainter.ie']]
  .forEach(function(p,i){
    var cx=ML+i*cW4+cW4/2;
    doc.setFont('helvetica','bold'); doc.setFontSize(7); setTxt(MGREY);
    doc.text(p[0].toUpperCase(),cx,y+6,{align:'center'});
    doc.setFont('helvetica','bold'); doc.setFontSize(8); setTxt(BLACK);
    doc.text(p[1],cx,y+13,{align:'center',maxWidth:cW4-4});
  });

  doc.save('DublinPainter-Price-List.pdf');
});
</script>
</body>
</html>
