  <meta name="twitter:description" content="Interior &amp; exterior painting, free quotes. Call 089 951 0552." />
  <meta name="twitter:image"       content="https://www.dublinpainter.ie/mariojpgb_wide.png" />

  <!-- ═══════════════════════════════════════════════════════════════
       SEO — LocalBusiness structured data (JSON-LD)
       FIX: logo updated from old filename to mariojpgb_wide.png
  ════════════════════════════════════════════════════════════════ -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "https://www.dublinpainter.ie/#business",
    "name": "DublinPainter.ie",
    "description": "Professional painter and decorator in Dublin offering interior and exterior painting, kitchen cabinet refinishing, mould-resistant coatings, and landlord painting services.",
    "url": "https://www.dublinpainter.ie/",
    "logo": "https://www.dublinpainter.ie/mariojpgb_wide.png",
    "image": "https://www.dublinpainter.ie/mariojpgb_wide.png",
    "telephone": "+353899510552",
    "email": "mario@dublinpainter.ie",
    "priceRange": "€€",
    "currenciesAccepted": "EUR",
    "paymentAccepted": "Cash, Bank Transfer",
    "areaServed": { "@type": "Country", "name": "Ireland" },
    "address": { "@type": "PostalAddress", "addressLocality": "Dublin", "addressCountry": "IE" },
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "08:00", "closes": "19:00"
    }],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Painting Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Interior Painting" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Exterior Painting" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Kitchen Cabinet Painting" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Landlord Painting" } }
      ]
    },
    "sameAs": ["https://www.facebook.com/painter.dublin.1/photos"]
  }
  </script>

  <!-- ═══════════════════════════════════════════════════════════════
       Google Analytics 4
       REQUIRED: replace GA4_MEASUREMENT_ID with your real ID.
       Find it: GA4 → Admin → Data Streams → Web stream details
       Example: G-A1B2C3D4E5
  ════════════════════════════════════════════════════════════════ -->
  <script>
    var GA4_ID = 'GA4_MEASUREMENT_ID'; /* <- REPLACE THIS */
    if (GA4_ID === 'GA4_MEASUREMENT_ID') {
      console.error('[DublinPainter] GA4 Measurement ID not set. Open index.html, find GA4_MEASUREMENT_ID and replace it with your real ID from GA4 → Admin → Data Streams.');
      window.dataLayer = window.dataLayer || [];
      window.gtag = function(){ window.dataLayer.push(arguments); };
    } else {
      (function(){ var s=document.createElement('script'); s.async=true; s.src='https://www.googletagmanager.com/gtag/js?id='+GA4_ID; document.head.appendChild(s); })();
      window.dataLayer = window.dataLayer || [];
      function gtag(){ window.dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA4_ID, { page_title:'DublinPainter.ie', page_location:'https://www.dublinpainter.ie/' });
    }
  </script>

  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet" />
  <style>
    :root {
      --black:  #000000; --dark:#111111; --card:#181818;
      --border: #2a2a2a; --green:#3ecf4e; --white:#ffffff;
      --grey:   #888888; --text:#cccccc;
    }
    body.light-mode {
      --black:#ffffff; --dark:#f5f5f5; --card:#ffffff; --border:#e0e0e0;
      --green:#22c55e; --white:#000000; --grey:#666666; --text:#1a1a1a;
    }
    body.light-mode .mob-menu    { background:#ffffff; }
    body.light-mode .sky         { background:#ffffff; }
    body.light-mode .sky svg path{ fill:#e0e0e0; }
    body.light-mode .fcopy       { background:#ffffff; color:#666666; }
    body.light-mode .fcopy a     { color:#22c55e; }
    body.light-mode .ptbl thead tr            { background:#f5f5f5; }
    body.light-mode .ptbl tbody tr:nth-child(even){ background:#fafafa; }
    body.light-mode .ptbl tbody tr:hover      { background:#f0f0f0; }
    body.light-mode .ptbl td                  { border-color:#e0e0e0; color:#1a1a1a; }
    body.light-mode .ptbl thead th            { border-color:#e0e0e0; }
    body.light-mode .ptbl td:last-child       { color:#1a1a1a; }
    body.light-mode .pt-sub      { color:#666666; }
    body.light-mode .sec-title   { color:#1a1a1a; }
    body.light-mode .pt-head     { color:#22c55e; }
    body.light-mode .citem .cv   { color:#1a1a1a; }
    body.light-mode .citem .cv a { color:#1a1a1a; }
    body.light-mode .citem .cv a:hover { color:#22c55e; }
    body.light-mode .furl        { color:#1a1a1a; }
    body.light-mode .nav-phone   { color:#22c55e; }
    body.light-mode .nav-phone:hover { color:#1a1a1a; background:#22c55e; }
    body.light-mode .nav-logo img{ filter:brightness(0.9); }
    body.light-mode .nav-links a { color:#666666; }
    body.light-mode .nav-links a:hover, body.light-mode .nav-links a.active { color:#1a1a1a; }
    body.light-mode .nav-links a::after { background:#22c55e; }
    body.light-mode .mob-menu a  { color:#666666; }
    body.light-mode .mob-menu a:hover { color:#22c55e; }
    body.light-mode .theme-toggle { color:#1a1a1a; }
    body.light-mode .theme-toggle:hover { color:#ffffff; }
    body.light-mode .hamburger   { color:#1a1a1a; }
    body.light-mode #hero-nav    { background:#ffffff; }
    body.light-mode .hn-theme    { color:#333; }
    body.light-mode .hn-hamburger{ color:#333; }

    * { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { font-family:'Montserrat',sans-serif; background:var(--black); color:var(--text); overflow-x:hidden; }
    ::-webkit-scrollbar{width:5px} ::-webkit-scrollbar-track{background:var(--black)} ::-webkit-scrollbar-thumb{background:var(--green);border-radius:3px}

    /* NAV */
    #mainNav { background:var(--black); border-bottom:1px solid var(--border); position:fixed; width:100%; top:0; z-index:1000; transform:translateY(-100%); transition:transform .35s ease,border-color .3s; }
    #mainNav.scrolled { transform:translateY(0); border-bottom-color:var(--green); }
    .nav-inner { display:flex; align-items:center; justify-content:space-between; padding:0 2rem; height:58px; }
    .nav-logo img { height:42px; width:auto; display:block; transition:transform .3s; }
    .nav-logo img:hover { transform:scale(1.06); }
    .nav-links { display:flex; list-style:none; }
    .nav-links a { display:block; color:var(--grey); text-decoration:none; font-size:.76rem; font-weight:700; letter-spacing:2.5px; text-transform:uppercase; padding:0 1.3rem; height:58px; line-height:58px; position:relative; transition:color .2s; }
    .nav-links a::after { content:''; position:absolute; bottom:0; left:1.3rem; right:1.3rem; height:2px; background:var(--green); transform:scaleX(0); transition:transform .25s; }
    .nav-links a:hover,.nav-links a.active { color:var(--white); }
    .nav-links a:hover::after,.nav-links a.active::after { transform:scaleX(1); }
    .nav-phone { color:var(--green); font-size:.8rem; font-weight:700; text-decoration:none; letter-spacing:1px; border:1px solid var(--green); padding:7px 14px; border-radius:3px; transition:background .2s,color .2s; white-space:nowrap; }
    .nav-phone:hover { background:var(--green); color:var(--black); }
    .hamburger { display:none; background:none; border:1px solid var(--border); color:var(--white); padding:8px 12px; cursor:pointer; font-size:1rem; border-radius:3px; }
    .theme-toggle { background:none; border:1px solid var(--border); color:var(--white); padding:8px 12px; cursor:pointer; font-size:1rem; border-radius:3px; transition:background .2s,color .2s; margin-right:8px; }
    .theme-toggle:hover { background:var(--green); color:var(--black); }

    /* Mobile drawer */
    .mob-menu { display:none; background:#0d0d0d; border-bottom:1px solid var(--border); padding:1rem 2rem; position:sticky; top:54px; z-index:998; }
    .mob-menu.open { display:block; }
    .mob-menu a { display:block; color:var(--grey); text-decoration:none; font-size:.82rem; font-weight:700; letter-spacing:2px; text-transform:uppercase; padding:12px 0; border-bottom:1px solid var(--border); transition:color .2s; }
    .mob-menu a:last-child { border-bottom:none; }
    .mob-menu a:hover { color:var(--green); }

    /* HERO */
    #hero { background:var(--black); line-height:0; position:relative; }
    #hero img { width:100%; height:auto; max-height:400px; object-fit:contain; object-position:center; display:block; }

    /* HERO-NAV */
    #hero-nav { position:sticky; top:0; z-index:999; background:var(--black); border-bottom:3px solid var(--green); display:flex; align-items:stretch; justify-content:center; }
    .hn-links { display:flex; list-style:none; margin:0; padding:0; flex:1; justify-content:center; }
    .hn-links a { display:flex; align-items:center; color:var(--grey); text-decoration:none; font-size:.75rem; font-weight:800; letter-spacing:3px; text-transform:uppercase; padding:0 2.2rem; height:54px; position:relative; transition:color .2s; }
    .hn-links a::after { content:''; position:absolute; bottom:0; left:2.2rem; right:2.2rem; height:3px; background:var(--green); transform:scaleX(0); transition:transform .25s; }
    .hn-links a:hover,.hn-links a.active { color:var(--white); }
    .hn-links a:hover::after,.hn-links a.active::after { transform:scaleX(1); }
    .hn-sep { width:1px; background:var(--border); margin:12px 0; }
    .hn-phone { display:flex; align-items:center; gap:9px; color:var(--green); font-size:.8rem; font-weight:800; text-decoration:none; letter-spacing:1px; padding:0 1.8rem; border-left:1px solid var(--border); transition:background .2s,color .2s; white-space:nowrap; }
    .hn-phone:hover { background:var(--green); color:var(--black); }
    .hn-theme { display:flex; align-items:center; background:none; border:none; border-left:1px solid var(--border); color:var(--white); padding:0 1.2rem; cursor:pointer; font-size:1rem; transition:background .2s,color .2s; margin-left:auto; }
    .hn-theme:hover { background:var(--green); color:var(--black); }
    .hn-hamburger { display:none; align-items:center; background:none; border:none; color:var(--white); font-size:1.1rem; padding:0 1.2rem; cursor:pointer; }
    @media(max-width:768px){ .hn-links,.hn-phone{display:none} .hn-hamburger{display:flex} }

    /* COMMONS */
    section { padding:80px 0; }
    .sec-label { font-size:.66rem; font-weight:700; letter-spacing:4px; text-transform:uppercase; color:var(--green); margin-bottom:7px; display:block; }
    .sec-title { font-size:clamp(1.5rem,3.5vw,2.3rem); font-weight:900; color:var(--white); margin-bottom:10px; line-height:1.15; }
    .sec-title span { color:var(--green); }
    .sec-line { width:38px; height:2px; background:var(--green); margin-bottom:2rem; }
    .reveal { opacity:0; transform:translateY(22px); transition:opacity .6s,transform .6s; }
    .reveal.visible { opacity:1; transform:translateY(0); }

    /* PRICES */
    #prices { background:var(--black); }
    .intro-card { background:var(--card); border:1px solid var(--border); border-radius:5px; padding:24px; font-size:.87rem; line-height:1.85; color:var(--text); }
    .intro-card p { margin-bottom:.8rem; }
    .intro-card p:last-child { margin:0; }

    /*
     * FIX: Previously two @keyframes both named "blink" existed in
     * the stylesheet. CSS last-write-wins, so the second declaration
     * (opacity-only, for .pcta-lbl) silently overrode the first
     * (scale+opacity, for .best-badge), stripping the badge of its
     * scale pulse entirely.
     *
     * Fix: renamed to distinct, descriptive names:
     *   blink-badge  →  scale + opacity  (used by .best-badge)
     *   blink-fade   →  opacity only     (used by .pcta-lbl)
     */
    .best-badge {
      width:96px; height:96px; border-radius:50%;
      border:3px dashed var(--green); background:var(--black);
      display:flex; flex-direction:column; align-items:center; justify-content:center;
      color:var(--green); font-weight:900; font-size:1.05rem; text-transform:uppercase;
      line-height:1.2; text-align:center; margin:0 auto;
      animation: blink-badge 1.5s infinite;
    }
    @keyframes blink-badge {
      0%, 100% { opacity:1; transform:scale(1); }
      50%       { opacity:0.5; transform:scale(1.05); }
    }

    .best-badge small { font-size:.62rem; letter-spacing:2px; }
    .pt-head { font-size:.92rem; font-weight:800; color:var(--green); border-left:3px solid var(--green); padding-left:11px; margin:38px 0 7px; }
    .pt-sub  { font-size:.81rem; color:var(--grey); line-height:1.75; margin-bottom:14px; }
    .ptbl    { width:100%; border-collapse:collapse; font-size:.81rem; margin-bottom:22px; }
    .ptbl thead tr { background:#161616; }
    .ptbl thead th { padding:9px 13px; color:var(--green); font-weight:700; font-size:.72rem; letter-spacing:1px; text-transform:uppercase; border:1px solid var(--border); text-align:left; }
    .ptbl tbody tr:nth-child(even) { background:#111; }
    .ptbl tbody tr:hover { background:#1a1a1a; }
    .ptbl td { padding:8px 13px; color:var(--text); border:1px solid var(--border); vertical-align:middle; }
    .ptbl td:last-child { color:var(--white); font-weight:700; white-space:nowrap; }
    .incl { list-style:none; display:flex; flex-wrap:wrap; gap:7px 26px; margin:8px 0 26px; padding:0; }
    .incl li { font-size:.8rem; color:var(--text); display:flex; align-items:center; gap:6px; }
    .incl li::before { content:'✓'; color:var(--green); font-weight:900; }
    .pcta { background:var(--card); border-top:1px solid var(--border); text-align:center; padding:46px 20px; margin-top:48px; }
    .pcta-lbl { font-size:clamp(1.3rem,3.5vw,1.6rem); font-weight:700; color:#ff0000; letter-spacing:3px; font-family:'Courier New',monospace; margin-bottom:16px; animation:blink-fade 1.5s infinite; }
    @keyframes blink-fade {
      0%, 100% { opacity:1; }
      50%       { opacity:0.5; }
    }
    .pcta-num { display:inline-flex; align-items:center; gap:13px; font-size:clamp(1.8rem,5vw,2.8rem); font-weight:900; color:var(--white); text-decoration:none; transition:color .2s; }
    .pcta-num:hover { color:var(--green); }
    .pcta-num i { color:var(--green); font-size:.8em; }

    /* ── TABLE — desktop layout ── */
    .table-responsive {
      display:block; width:100%; overflow-x:auto;
      -webkit-overflow-scrolling:touch;
    }
    .ptbl thead th { white-space:nowrap; }
    .ptbl tbody td { word-break:normal; overflow-wrap:break-word; }

    /* ── TABLE — mobile card layout (no horizontal scroll) ──
       On small screens each <tr> becomes a self-contained card.
       Each <td> shows its column name as a left-aligned label
       via a data-label attribute set in JS, and the value sits
       on the right. No scrolling needed — everything fits.      */
    @media(max-width:600px){
      /* Kill the horizontal scroller */
      .table-responsive { overflow-x:visible; }

      /* Hide the original header row — labels come from data-label */
      .ptbl thead { display:none; }

      /* Each row = a card */
      .ptbl tbody tr {
        display:block;
        background:var(--card) !important;
        border:1px solid var(--border);
        border-radius:6px;
        margin-bottom:10px;
        padding:4px 0;
        box-shadow:0 2px 8px rgba(0,0,0,.18);
      }
      .ptbl tbody tr:hover { background:var(--card) !important; }

      /* Each cell = a label/value row inside the card */
      .ptbl tbody td {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:8px;
        padding:8px 14px;
        border:none;
        border-bottom:1px solid var(--border);
        white-space:normal;
        font-size:.82rem;
      }
      .ptbl tbody td:last-child {
        border-bottom:none;
        color:var(--green) !important;
        font-weight:800;
      }

      /* Column label injected by JS via ::before */
      .ptbl tbody td::before {
        content:attr(data-label);
        font-size:.65rem;
        font-weight:700;
        letter-spacing:1.5px;
        text-transform:uppercase;
        color:var(--grey);
        white-space:nowrap;
        flex-shrink:0;
      }
    }
    #services { background:var(--dark); }

    /* WORKS */
    #work { background:var(--black); }
    .wgrid { display:grid; grid-template-columns:repeat(3,1fr); gap:3px; }
    .witem { position:relative; overflow:hidden; aspect-ratio:4/3; background:var(--card); cursor:pointer; }
    .witem.big { grid-column:span 2; aspect-ratio:16/7; }
    .witem img { width:100%; height:100%; object-fit:cover; transition:transform .5s,filter .4s; filter:brightness(.7) saturate(.8); }
    .witem:hover img { transform:scale(1.07); filter:brightness(.45) saturate(.4); }
    .fb-wrap { text-align:center; margin-top:30px; }
    .fb-btn { display:inline-flex; align-items:center; gap:10px; background:var(--green); color:#fff; text-decoration:none; padding:12px 28px; border-radius:4px; font-weight:700; font-size:.86rem; transition:background .3s,transform .2s; box-shadow:0 4px 18px rgba(62,207,78,.3); }
    .fb-btn:hover { background:#2fb83e; color:#fff; transform:translateY(-2px); }
    .fb-sub { display:block; margin-top:9px; font-size:.75rem; color:var(--grey); letter-spacing:1px; }

    /* CONTACT STRIP */
    #cstrip { background:var(--card); border-top:2px solid var(--green); padding:44px 0; }
    .cgrid { display:flex; flex-wrap:wrap; justify-content:center; gap:0; }
    .citem { flex:1; min-width:160px; padding:24px 20px; text-align:center; border-right:1px solid var(--border); overflow:hidden; }
    /* Email item gets more space and no overflow hidden */
    .citem:nth-child(2) { flex-basis:280px; min-width:280px; overflow:visible; }
    .citem:last-child { border-right:none; }
    .citem i { font-size:1.4rem; color:var(--green); margin-bottom:9px; display:block; }
    .citem .cl { font-size:.62rem; letter-spacing:2.5px; text-transform:uppercase; color:var(--grey); margin-bottom:5px; }
    .citem .cv { font-size:.92rem; font-weight:700; color:var(--white); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .citem .cv a { color:var(--white); text-decoration:none; transition:color .2s; }
    .citem .cv a:hover { color:var(--green); }
    /* Email item value gets no overflow handling */
    .citem:nth-child(2) .cv { overflow:visible; text-overflow:clip; }
    /* Email link — stays on one line, font shrinks with viewport to fit.
       clamp(min, preferred, max):
         min  = 0.60rem  — absolute floor so text stays legible on mobile
         pref = 4.5vw    — scales with screen width (fits 23 chars at ~320px)
         max  = 0.92rem  — normal desktop size                                  */
    #email-link {
      display:block;
      white-space:nowrap;
      font-size:clamp(0.60rem, 4.5vw, 0.92rem);
    }

    /* FOOTER */
    footer { background:#040404; border-top:1px solid var(--border); }
    .sky  { position:relative; padding:40px 0; background:#040404; text-align:center; }
    .furl { position:absolute; bottom:20px; left:0; right:0; text-align:center;
            font-size:clamp(.82rem,2.2vw,1.25rem); font-weight:400;
            letter-spacing:clamp(4px,2vw,14px); color:var(--white); z-index:2; }
    .fcopy { background:var(--black); color:var(--grey); padding:11px; font-size:.7rem; text-align:center; letter-spacing:.5px; }
    .fcopy a { color:var(--green); text-decoration:none; }

    /* SCROLL TOP */
    #st { position:fixed; bottom:22px; right:22px; width:42px; height:42px;
          background:var(--green); color:var(--black); border:none; border-radius:3px;
          font-size:.95rem; cursor:pointer; opacity:0; transform:translateY(14px);
          transition:all .3s; z-index:999; display:-webkit-box; display:flex;
          -webkit-box-align:center; align-items:center;
          -webkit-box-pack:center;  justify-content:center; font-weight:900; }
    #st.visible { opacity:1; transform:translateY(0); }
    #st:hover { background:#2fb83e; }

    /* ══════════════════════════════════════════════════════════════
       RESPONSIVE — mobile Firefox fixes
       Firefox for Android applies a default minimum font-size of
       ~9px and doesn't honour -webkit- prefixes, so we:
         1. Add -moz- prefixed flex where needed
         2. Ensure tap targets are ≥ 44px (WCAG / Firefox UX pref)
         3. Remove letter-spacing on tiny text (Firefox renders it
            wider than Chrome, causing horizontal overflow)
         4. Force table cells to break long words
    ══════════════════════════════════════════════════════════════ */
    @media(max-width:768px){
      .nav-links,.nav-phone { display:none; }
      .hamburger { display:block; }
      #hero img { max-height:260px; }

      /* nav tap targets */
      .hamburger, .theme-toggle { min-height:44px; min-width:44px; }
      .hn-hamburger, .hn-theme  { min-height:44px; min-width:44px; }

      /* hero-nav: Firefox needs explicit -moz- flex display */
      #hero-nav {
        display:-moz-box; display:flex;
        -moz-box-align:stretch; align-items:stretch;
      }

      /* section heading letter-spacing collapses on Firefox mobile */
      .sec-title { letter-spacing:0; }
      .sec-label  { letter-spacing:2px; }

      /* works grid */
      .wgrid { grid-template-columns:1fr 1fr; }
      .witem.big { grid-column:span 2; aspect-ratio:4/3; }

      /* contact strip: stack vertically, no side borders */
      .citem { border-right:none; border-bottom:1px solid var(--border); }
      .citem:last-child { border-bottom:none; }

      section { padding:56px 0; }
      .nav-inner { padding:0 1rem; }
    }

    @media(max-width:900px){
      .wgrid { grid-template-columns:1fr; }
      .witem.big { grid-column:span 1; }

      /* pcta phone number — prevent horizontal scroll on Firefox */
      .pcta-num { font-size:clamp(1.4rem,8vw,2.8rem); }

      /* contact strip: stack vertically on small screens */
      .cgrid { flex-direction:column; }
      .citem { border-right:none; border-bottom:1px solid var(--border); max-width:none; }
      .citem:nth-child(2) { flex-basis:auto; min-width:160px; }
      .citem:last-child { border-bottom:none; }
    }
  </style>
</head>
